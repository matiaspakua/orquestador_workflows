# PostgreSQL
POSTGRES_USER=eventuser
POSTGRES_PASSWORD=eventpass
POSTGRES_DB=eventdb

# Kafka
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=data-events
CONSUMER_GROUP=data-processors

# Producer — interval between generated domain events (seconds)
PRODUCER_INTERVAL=5

# Orchestrator — interval between new workflow executions (seconds)
WORKFLOW_INTERVAL=60
