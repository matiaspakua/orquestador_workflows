{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event/step-started",
  "title": "StepStarted",
  "description": "Emitted when a step begins execution",
  "type": "object",
  "required": ["event_type", "schema_version", "workflow_execution_id", "step_id", "step_name", "timestamp", "payload"],
  "properties": {
    "event_type": { "type": "string", "const": "StepStarted" },
    "schema_version": { "type": "integer", "const": 1 },
    "workflow_id": { "type": "string", "format": "uuid" },
    "workflow_execution_id": { "type": "string", "format": "uuid" },
    "workflow_definition_id": { "type": "string", "format": "uuid" },
    "step_id": { "type": "string" },
    "step_name": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["step_id", "step_name", "step_type", "attempt"],
      "properties": {
        "step_id": { "type": "string" },
        "step_name": { "type": "string" },
        "step_type": { "type": "string", "enum": ["Task", "Decision", "Parallel", "Wait"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "input": { "type": "object" }
      }
    }
  }
}
