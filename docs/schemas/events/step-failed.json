{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event/step-failed",
  "title": "StepFailed",
  "description": "Emitted when a step fails",
  "type": "object",
  "required": ["event_type", "schema_version", "workflow_execution_id", "step_id", "step_name", "timestamp", "payload"],
  "properties": {
    "event_type": { "type": "string", "const": "StepFailed" },
    "schema_version": { "type": "integer", "const": 1 },
    "workflow_id": { "type": "string", "format": "uuid" },
    "workflow_execution_id": { "type": "string", "format": "uuid" },
    "workflow_definition_id": { "type": "string", "format": "uuid" },
    "step_id": { "type": "string" },
    "step_name": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["step_id", "error_message", "error_code", "attempt", "will_retry"],
      "properties": {
        "step_id": { "type": "string" },
        "error_message": { "type": "string" },
        "error_code": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "will_retry": { "type": "boolean" },
        "next_retry_in_seconds": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    }
  }
}
