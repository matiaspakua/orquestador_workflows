{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event/workflow-failed",
  "title": "WorkflowFailed",
  "description": "Emitted when a workflow terminates due to an unrecoverable error",
  "type": "object",
  "required": ["event_type", "schema_version", "workflow_execution_id", "timestamp", "payload"],
  "properties": {
    "event_type": { "type": "string", "const": "WorkflowFailed" },
    "schema_version": { "type": "integer", "const": 1 },
    "workflow_id": { "type": "string", "format": "uuid" },
    "workflow_execution_id": { "type": "string", "format": "uuid" },
    "workflow_definition_id": { "type": "string", "format": "uuid" },
    "step_id": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "step_name": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["error", "error_code", "total_duration_ms", "steps_completed"],
      "properties": {
        "error": { "type": "string" },
        "error_code": { "type": "string" },
        "failed_step_id": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "failed_step_name": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "total_duration_ms": { "type": "integer", "minimum": 0 },
        "steps_completed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
