{
  "title": "Infrastructure Alerts",
  "uid": "infra-alerts",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s","1m","5m","15m","1h"] },
  "templating": {
    "list": [
      {
        "name": "status",
        "label": "Alert Status",
        "type": "custom",
        "options": [
          { "text": "All",      "value": "" },
          { "text": "Firing",   "value": "firing" },
          { "text": "Resolved", "value": "resolved" }
        ],
        "current": { "text": "All", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "Firing" }],
      "fieldConfig": { "defaults": { "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 2,
      "title": "Critical Alerts",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"})", "legendFormat": "Critical" }],
      "fieldConfig": { "defaults": { "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "title": "Warning Alerts",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\",severity=\"warning\"})", "legendFormat": "Warning" }],
      "fieldConfig": { "defaults": { "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }] } } }
    },
    {
      "id": 4,
      "title": "Alert History",
      "type": "table",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "targets": [{ "expr": "ALERTS", "legendFormat": "", "instant": true }],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "severity" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "mappings", "value": [{ "options": { "critical": { "color": "red", "index": 0 }, "warning": { "color": "yellow", "index": 1 } }, "type": "value" }] }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "severity", "desc": true }] }
    },
    {
      "id": 5,
      "title": "CPU Alert Trend",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "targets": [
        { "expr": "ALERTS{alertname=~\"ContainerCPU.*\"}", "legendFormat": "{{alertname}} / {{container}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "nullValueMode": "null" } }
    },
    {
      "id": 6,
      "title": "Memory Alert Trend",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "targets": [
        { "expr": "ALERTS{alertname=~\"ContainerMemory.*\"}", "legendFormat": "{{alertname}} / {{container}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "nullValueMode": "null" } }
    }
  ]
}
