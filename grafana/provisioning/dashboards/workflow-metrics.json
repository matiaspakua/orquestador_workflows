{
  "title": "Workflow Processing Metrics",
  "uid": "workflow-metrics",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s","10s","30s","1m","5m","15m","1h","24h"] },
  "panels": [
    {
      "id": 1,
      "title": "Total Executions",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "noValue": "No data" } },
      "targets": [{ "expr": "sum(workflow_executions_total)", "legendFormat": "Total" }]
    },
    {
      "id": 2,
      "title": "Currently Running",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } },
      "targets": [{ "expr": "workflow_running", "legendFormat": "Running" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 3,
      "title": "Completed vs Failed",
      "type": "piechart",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "sum(workflow_executions_total{status=\"Completed\"})", "legendFormat": "Completed" },
        { "expr": "sum(workflow_executions_total{status=\"Failed\"})",    "legendFormat": "Failed" }
      ]
    },
    {
      "id": 4,
      "title": "Execution Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(workflow_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(workflow_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(workflow_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "nullValueMode": "null" } }
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
      "targets": [{ "expr": "rate(workflow_executions_total{status=\"Failed\"}[5m])", "legendFormat": "Failed/s" }],
      "fieldConfig": { "defaults": { "unit": "short", "nullValueMode": "null" } }
    },
    {
      "id": 6,
      "title": "Executions by Workflow Name",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [{ "expr": "sum by (workflow_name) (workflow_executions_total)", "legendFormat": "{{workflow_name}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
