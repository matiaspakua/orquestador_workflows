{
  "title": "Message Processing Metrics",
  "uid": "message-metrics",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s","10s","30s","1m","5m","15m","1h","24h","7d"] },
  "panels": [
    {
      "id": 1,
      "title": "Publish Rate (msg/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [{ "expr": "messages_publish_rate", "legendFormat": "{{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "nullValueMode": "null" } }
    },
    {
      "id": 2,
      "title": "Consume Rate (msg/s)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [{ "expr": "messages_consume_rate", "legendFormat": "{{consumer_id}} / {{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "nullValueMode": "null" } }
    },
    {
      "id": 3,
      "title": "Total Published",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(messages_published_total)", "legendFormat": "Published" }]
    },
    {
      "id": 4,
      "title": "Total Consumed",
      "type": "stat",
      "gridPos": { "x": 4, "y": 6, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(messages_consumed_total)", "legendFormat": "Consumed" }]
    },
    {
      "id": 5,
      "title": "Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
      "targets": [{ "expr": "consumer_lag", "legendFormat": "{{consumer_id}} P{{partition}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "nullValueMode": "null", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } } }
    },
    {
      "id": 6,
      "title": "Publish vs Consume (total)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        { "expr": "sum(messages_published_total)",  "legendFormat": "Published" },
        { "expr": "sum(messages_consumed_total)",   "legendFormat": "Consumed" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "nullValueMode": "null" } }
    }
  ]
}
